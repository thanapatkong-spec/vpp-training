# --- ฐานข้อมูล (Neon/Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/vpp   # ใช้ทั้งตอนรันเว็บและ drizzle-kit (Vercel + Neon ใส่ให้เอง)
# NUXT_DATABASE_URL=...                                # ถ้าตั้ง จะใช้แทน DATABASE_URL ตอนรันเว็บ

# --- ระบบสมาชิก (ดู docs/members-setup.md) ---
NUXT_PUBLIC_MEMBERS_ENABLED=false     # true เมื่อ deploy แบบมีเซิร์ฟเวอร์ (Vercel) แล้ว
BETTER_AUTH_SECRET=                   # สุ่มสตริงยาว ≥ 32 ตัวอักษร (เช่น openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000 # URL จริงของเว็บ
# TRUSTED_ORIGINS=https://example.com # โดเมนเพิ่มเติมที่ล็อกอินได้ (vetvpp.com / www / vercel.app มีให้แล้ว)
ADMIN_KEY=                            # (ไม่บังคับ) รหัสแอดมินพิเศษ ≥12 ตัวอักษร ใช้แทนการยืนยันอีเมล (อีเมลต้องอยู่ใน ADMIN_EMAILS ด้วย)
BLOB_READ_WRITE_TOKEN=                # (ไม่บังคับ) Vercel → Storage → Blob → Connect: รูป/ไฟล์ที่อัปโหลดในแอดมินเก็บที่ Blob · ไม่ตั้ง = เก็บในฐานข้อมูล
ADMIN_EMAILS=                         # อีเมลแอดมิน คั่นด้วยจุลภาค (ต้องยืนยันอีเมลแล้วถึงเป็นแอดมินได้)

# อีเมลจากระบบ — เลือกแบบใดแบบหนึ่ง ไม่ตั้งเลย = พิมพ์ลง log (ใช้ตอนพัฒนา)
# แบบ ก: Gmail / Google Workspace (ใช้รหัสผ่านสำหรับแอป ต้องเปิดยืนยันตัวตน 2 ขั้นตอนก่อน)
SMTP_USER=                            # เช่น info@vetvpp.com
SMTP_PASS=                            # รหัสผ่านสำหรับแอป 16 ตัว (ไม่ใช่รหัสผ่านล็อกอิน)
SMTP_HOST=                            # ไม่ตั้ง = smtp.gmail.com
SMTP_PORT=                            # ไม่ตั้ง = 465
# แบบ ข: Resend (ต้องยืนยันโดเมนใน Resend)
RESEND_API_KEY=
MAIL_FROM=                            # ไม่ตั้ง = "VPP <SMTP_USER>" (Gmail) / ตั้งเช่น "VPP <no-reply@vetvpp.com>" (Resend)

# ล็อกอินด้วย Google (ไม่ตั้ง = ซ่อนปุ่ม Google)
NUXT_PUBLIC_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ชำระค่าเรียน (พร้อมเพย์ + สลิป) ---
# ค่าเริ่มต้น (ไม่ต้องตั้ง) = QR ชำระบิลของ Dr.John Pet Co., Ltd. (SCB 038-485804-4) ตาม QR ที่ธนาคารออกให้
PROMPTPAY_ID=                         # (ทางเลือก) ใช้พร้อมเพย์ทั่วไปแทน: เบอร์มือถือ หรือเลขผู้เสียภาษี 13 หลัก
PROMPTPAY_NAME=                       # ชื่อบัญชีที่แสดงใต้ QR
PAY_BANK_INFO=                        # ข้อความบัญชีธนาคารใต้ QR
PROMPTPAY_BILLER_ID=                  # (QR ชำระบิล) Biller ID 15 หลัก / PROMPTPAY_REF1 / PROMPTPAY_REF2 / PROMPTPAY_TERMINAL
SLIPOK_BRANCH_ID=                     # (ตรวจสลิปอัตโนมัติ) Branch ID จาก slipok.com
SLIPOK_API_KEY=                       # API key จาก slipok.com — ไม่ตั้ง = แอดมินตรวจสลิปเอง
# --- อีเมล ---
MAIL_REPLY_TO=info@vetvpp.com         # ผู้สมัครกดตอบกลับอีเมลแล้วถึงทีมงาน
REQUIRE_EMAIL_VERIFICATION=           # true = ต้องยืนยันอีเมลก่อนล็อกอิน (ค่าเริ่มต้น: ไม่บังคับ แต่ยังส่งลิงก์ยืนยัน)
