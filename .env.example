# --- ฐานข้อมูล (Neon/Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/vpp   # ใช้ทั้งตอนรันเว็บและ drizzle-kit (Vercel + Neon ใส่ให้เอง)
# NUXT_DATABASE_URL=...                                # ถ้าตั้ง จะใช้แทน DATABASE_URL ตอนรันเว็บ

# --- ระบบสมาชิก (ดู docs/members-setup.md) ---
NUXT_PUBLIC_MEMBERS_ENABLED=false     # true เมื่อ deploy แบบมีเซิร์ฟเวอร์ (Vercel) แล้ว
BETTER_AUTH_SECRET=                   # สุ่มสตริงยาว ≥ 32 ตัวอักษร (เช่น openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000 # URL จริงของเว็บ
ADMIN_KEY=                            # (ไม่บังคับ) รหัสแอดมินพิเศษ ≥12 ตัวอักษร ใช้แทนการยืนยันอีเมล (อีเมลต้องอยู่ใน ADMIN_EMAILS ด้วย)
GITHUB_TOKEN=                         # (หน้าแอดมิน > เนื้อหาเว็บ) Fine-grained token ของ repo นี้ สิทธิ์ Contents: Read and write
ADMIN_EMAILS=                         # อีเมลแอดมิน คั่นด้วยจุลภาค (ต้องยืนยันอีเมลแล้วถึงเป็นแอดมินได้)

# อีเมลยืนยัน/ตั้งรหัสผ่านใหม่ (Resend) — ไม่ตั้ง = พิมพ์ลิงก์ลง log (ใช้ตอนพัฒนา) และไม่บังคับยืนยันอีเมล
RESEND_API_KEY=
MAIL_FROM="VPP <no-reply@your-domain>"

# ล็อกอินด้วย Google (ไม่ตั้ง = ซ่อนปุ่ม Google)
NUXT_PUBLIC_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ชำระค่าเรียน (พร้อมเพย์ + สลิป) ---
PROMPTPAY_ID=                         # เบอร์พร้อมเพย์ หรือเลขผู้เสียภาษี 13 หลักของบริษัท (ผู้รับเงินค่าเรียน)
PROMPTPAY_NAME=                       # ชื่อบัญชีที่แสดงใต้ QR เช่น บริษัท ดร.จอห์นเพ็ท จำกัด
SLIPOK_BRANCH_ID=                     # (ตรวจสลิปอัตโนมัติ) Branch ID จาก slipok.com
SLIPOK_API_KEY=                       # API key จาก slipok.com — ไม่ตั้ง = แอดมินตรวจสลิปเอง
# --- อีเมล (Resend) ---
MAIL_REPLY_TO=info@vetvpp.com         # ผู้สมัครกดตอบกลับอีเมลแล้วถึงทีมงาน
